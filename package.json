{
  "name": "her-growth-diary-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend foundation for Her Growth Diary",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "admin:setup": "tsx src/scripts/setup-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "multer": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.10",
    "prisma": "^6.19.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
