# Copy the direct PostgreSQL connection string from Neon.
DATABASE_URL="PASTE_NEON_DIRECT_CONNECTION_STRING_HERE"
# Required only for database tests; use a separate disposable database named hgd_test_<name>.
# TEST_DATABASE_URL="PASTE_DISPOSABLE_TEST_CONNECTION_STRING_HERE"
# Required only for the explicit disposable test database reset command.
# TEST_DATABASE_DISPOSABLE_CONFIRMATION="I_UNDERSTAND_THIS_DATABASE_WILL_BE_RESET"
# TEST_DATABASE_APPROVED_TARGET="postgres://host:5432/hgd_test_local"
PORT=5000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API with credentials.
FRONTEND_ORIGINS="http://localhost:8443,https://her-growth-diary-d1ttrthw2-adeyinka3.vercel.app"
# Used only by `npm run admin:setup`; never expose these through the API.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-long-unique-password
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
